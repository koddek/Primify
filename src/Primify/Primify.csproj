<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Multi-targeted: net10.0 (LTS) for consumers still on it, net11.0 for the current SDK. No package
             dependencies; System.Text.Json is in-box for both. -->
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <PackageId>Primify</PackageId>
        <Version>3.0.0</Version>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <!-- No package dependencies: the generator emits LiteDB/Newtonsoft.Json adapter code into the
         consumer only when those packages are referenced there. System.Text.Json ships in the framework. -->

    <ItemGroup>
        <!-- Agent-facing skill travels with the package; tools can read it from the extracted package folder. -->
        <None Include="..\..\skills\primify\SKILL.md"
              Pack="true"
              PackagePath="skills/primify/"
              Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Keep the reference for development support -->
        <ProjectReference Include="..\Primify.Generators\Primify.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>

        <!-- Pack only required analyzer binaries to avoid shipping Roslyn runtime assemblies -->
        <None Include="..\Primify.Generators\bin\$(Configuration)\netstandard2.0\Primify.Generators.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

</Project>
