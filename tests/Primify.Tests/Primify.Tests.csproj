<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <!-- CS1591: no documented public surface. PRIT007: UnsupportedLiteDbWrapper intentionally has no LiteDB
             bridge; pragma cannot suppress generator diagnostics, and PRIT007 coverage lives in SerializerAdapterTests. -->
        <NoWarn>$(NoWarn);CS1591;PRIT007</NoWarn>
        <IsPackable>false</IsPackable>
        <RootNamespace>Primify.Generator.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LiteDB" Version="5.0.21"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3"/>
        <PackageReference Include="Flowgen" Version="0.12.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="TUnit" Version="1.78.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Primify.Generators\Primify.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\src\Primify.Generators\Primify.Generators.csproj" />
        <ProjectReference Include="..\..\src\Primify\Primify.csproj"/>

        <Analyzer Include="..\..\src\Primify.Generators\bin\$(Configuration)\netstandard2.0\Flowgen.dll" />
    </ItemGroup>

</Project>
